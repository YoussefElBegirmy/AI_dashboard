# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://aieval:aieval@localhost:5432/aieval

# API server
PORT=3001
# Public URL of the web app (used for CORS and invite links)
APP_URL=http://localhost:5173
# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Long random string used to encrypt project secrets (API keys) at rest. Do not lose it.
MASTER_KEY=change-me-to-another-long-random-string
# Allow anyone to register (otherwise only the first user or invited users)
ALLOW_SIGNUP=false
# Enable /dev/mock/* endpoints for trying out HTTP targets
ENABLE_DEV_MOCKS=true

# Optional fallbacks used when a project has no secret with that name
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Disposable database for API integration tests (npm run test:api)
TEST_DATABASE_URL=postgresql://aieval:aieval@localhost:5432/aieval_test
